# Runtime
NODE_ENV=production
PORT=5000
PHARMACY_DATA_DIR=/data

# Browser origin allowed to call the API when hosted separately.
# Leave empty when the UI and API are served from the same domain.
FRONTEND_ORIGIN=

# Used only when the database has no users yet.
ADMIN_EMAIL=admin@pharmacy.local
ADMIN_PASSWORD=replace-with-a-long-random-password
SEED_DEMO_DATA=false
